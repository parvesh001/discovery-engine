{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql --",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "ingest:worker": "tsx src/scripts/ingest-worker.ts",
    "test:query-understanding": "tsx src/scripts/testQueryUnderstanding.ts",
    "test:retrieval": "tsx src/scripts/testRetrieval.ts",
    "test:rerank": "tsx src/scripts/testRerank.ts",
    "eval": "tsx src/evals/runEvals.ts",
    "cost-model": "tsx src/scripts/costModel.ts",
    "loadtest": "tsx src/scripts/loadtest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "bullmq": "^6.0.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^6.0.0",
    "langfuse": "^3.38.20",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autocannon": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
