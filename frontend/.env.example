# Base URL of the backend API.
#
# Local dev: unset is fine — app/page.tsx and app/search/useSearch.ts fall back to
# http://localhost:4000. Set it here only if your backend runs elsewhere.
#
# Production (Vercel): set as a Project Environment Variable pointing at the deployed
# Render backend, e.g. NEXT_PUBLIC_BACKEND_URL=https://discovery-engine-backend.onrender.com
# It is read at build time. The NEXT_PUBLIC_ prefix means it is embedded in the browser
# bundle — never put a secret in a NEXT_PUBLIC_ var. See DEPLOYMENT.md.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
